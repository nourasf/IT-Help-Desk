# Railway / production settings
ConnectionStrings__DefaultConnection=Server=tcp:YOUR-SQL-SERVER.database.windows.net,1433;Initial Catalog=ITHelpDesk;Persist Security Info=False;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Frontend__AllowedOrigins=https://YOUR-FRONTEND.vercel.app

# Use a long random key in production. Do not commit the real value.
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET
Jwt__Issuer=ITHelpDeskAPI
Jwt__Audience=ITHelpDeskFrontend
Jwt__ExpiryMinutes=60

# Optional password-recovery email settings
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromAddress=
Email__FromName=SupportHub
Email__EnableSsl=true
Email__FrontendBaseUrl=https://YOUR-FRONTEND.vercel.app
